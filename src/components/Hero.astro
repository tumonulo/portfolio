---
const { t } = Astro.props;
---

<section class="flex min-h-screen flex-col items-center justify-center px-6 py-16 text-center relative">
	<div class="relative inline-block">
		<div
			class="absolute -inset-3 rounded-full bg-gradient-to-r from-blue to-blue-light blur-2xl"
		></div>
		<div class="w-40 h-40 rounded-full bg-gradient-to-br from-blue to-blue-light flex items-center justify-center text-5xl font-bold text-white shadow-lg shadow-blue/30">T</div>
	</div>

	<h1 class="mt-8 text-4xl font-bold tracking-tight text-white sm:text-5xl font-display">
		<span class="lang-en">{t.en.greeting}</span>
		<span class="lang-es">{t.es.greeting}</span>{' '}
		<span class="text-blue">{t.en.name}</span>
		<span class="lang-es" style="display:none">{t.es.name}</span>
	</h1>

	<p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-400">
		<span class="lang-en">{t.en.desc}</span>
		<span class="lang-es" style="display:none">{t.es.desc}</span>
	</p>

	<div class="mt-10 flex flex-wrap items-center justify-center gap-4">
		<a
			href="https://github.com/tumonulo/repositories"
			class="btn-animate inline-flex items-center gap-2 rounded-full bg-blue px-6 py-3 text-sm font-medium text-white transition hover:bg-white hover:text-blue hover:shadow-lg hover:shadow-blue/40"
		>
			<span class="lang-en">{t.en.projects}</span>
			<span class="lang-es" style="display:none">{t.es.projects}</span>
		</a>
		<a
			href="https://github.com/tumonulo"
			class="btn-animate inline-flex items-center gap-2 rounded-full border border-blue px-6 py-3 text-sm font-medium text-blue transition hover:bg-blue hover:text-white hover:shadow-lg hover:shadow-blue/30"
		>
			<span class="lang-en">{t.en.github}</span>
			<span class="lang-es" style="display:none">{t.es.github}</span>
		</a>
	</div>
</section>

<style>
	.btn-animate {
		position: relative;
		overflow: hidden;
		transition: transform 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, color 0.25s ease;
	}
	.btn-animate::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.35), transparent);
		transform: translateX(-100%);
		transition: transform 0.5s ease;
	}
	.btn-animate:hover::after {
		transform: translateX(100%);
	}
	.btn-animate:hover {
		transform: scale(1.05);
	}
	.btn-animate:active {
		transform: scale(0.97);
	}
</style>